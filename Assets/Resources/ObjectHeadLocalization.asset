  defaultLanguage: 0
  entries:
  - key: game_title
    korean: "\uC624\uBE0C\uC81D\uD2B8 \uD5E4\uB4DC \uBC30\uD2C0"
    english: OBJECT HEAD BATTLE
  - key: subtitle
    korean: "\uBA38\uB9AC\uB97C \uB358\uC9C0\uACE0, \uC9C0\uD615\uC744 \uBC14\uAFB8\uACE0,
      \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uC73C\uC138\uC694!"
    english: Throw heads, reshape the terrain, and be the last team standing!
  - key: language_korean
    korean: "\uD55C\uAD6D\uC5B4"
    english: Korean
  - key: language_english
    korean: English
    english: English
  - key: nickname_label
    korean: "\uB2C9\uB124\uC784"
    english: Nickname
  - key: nickname_placeholder
    korean: "\uB2C9\uB124\uC784\uC744 \uC785\uB825\uD558\uC138\uC694"
    english: Enter nickname
  - key: room_size_label
    korean: "\uBC29 \uC778\uC6D0"
    english: Room size
  - key: room_size_value
    korean: "{0}\uC778"
    english: '{0} players'
  - key: create_room
    korean: "\uBC29 \uB9CC\uB4E4\uAE30"
    english: Create room
  - key: quick_match_title
    korean: "\uBE60\uB978 \uB79C\uB364 \uB9E4\uCE6D"
    english: Quick matchmaking
  - key: quick_match_2
    korean: "2\uC778"
    english: 2 players
  - key: quick_match_3
    korean: "3\uC778"
    english: 3 players
  - key: quick_match_4
    korean: "4\uC778"
    english: 4 players
  - key: join_title
    korean: "\uBC29 \uCF54\uB4DC\uB85C \uCC38\uAC00"
    english: Join with room code
  - key: room_code_placeholder
    korean: "6\uC790\uB9AC \uBC29 \uCF54\uB4DC"
    english: 6-character room code
  - key: join_room
    korean: "\uCC38\uAC00"
    english: Join
  - key: cancel_matchmaking
    korean: "\uB9E4\uCE6D \uCDE8\uC18C"
    english: Cancel matchmaking
  - key: connection_hint
    korean: "\uC11C\uBC84 \uC5F0\uACB0\uC740 \uBA54\uB274 \uC120\uD0DD \uC2DC \uC790\uB3D9\uC73C\uB85C
      \uC9C4\uD589\uB429\uB2C8\uB2E4."
    english: The game connects to the server automatically.
  - key: lobby_host_title
    korean: "\uBC29 \uB85C\uBE44 \xB7 \uBC29\uC7A5"
    english: "ROOM LOBBY \xB7 HOST"
  - key: lobby_guest_title
    korean: "\uBC29 \uB85C\uBE44"
    english: ROOM LOBBY
  - key: room_code_value
    korean: "\uBC29 \uCF54\uB4DC: {0}"
    english: 'Room code: {0}'
  - key: player_count_value
    korean: "\uCC38\uAC00\uC790 {0}/{1}"
    english: Players {0}/{1}
  - key: room_settings
    korean: "\uBC29 \uC124\uC815"
    english: Room settings
  - key: map_fixed
    korean: "\uACE0\uC815 \uB9F5"
    english: Fixed map
  - key: map_random
    korean: "\uB79C\uB364 \uB9F5"
    english: Random map
  - key: toggle_map_mode
    korean: "\uB9F5 \uC120\uD0DD \uC804\uD658"
    english: Toggle map selection
  - key: apply_settings
    korean: "\uC124\uC815 \uC801\uC6A9"
    english: Apply settings
  - key: copy_room_code
    korean: "\uCF54\uB4DC \uBCF5\uC0AC"
    english: Copy code
  - key: ready
    korean: "\uC900\uBE44"
    english: Ready
  - key: cancel_ready
    korean: "\uC900\uBE44 \uCDE8\uC18C"
    english: Cancel ready
  - key: start_game
    korean: "\uAC8C\uC784 \uC2DC\uC791"
    english: Start game
  - key: leave_room
    korean: "\uB098\uAC00\uAE30"
    english: Leave
  - key: waiting_for_players
    korean: "\uCC38\uAC00\uC790\uB97C \uAE30\uB2E4\uB9AC\uB294 \uC911..."
    english: Waiting for players...
  - key: host_mark
    korean: "[\uBC29\uC7A5]"
    english: '[HOST]'
  - key: ready_state
    korean: "\uC900\uBE44 \uC644\uB8CC"
    english: READY
  - key: not_ready_state
    korean: "\uC900\uBE44 \uC804"
    english: NOT READY
  - key: status_offline
    korean: "\uBA54\uB274\uB97C \uC120\uD0DD\uD558\uBA74 \uC11C\uBC84\uC5D0 \uC5F0\uACB0\uB429\uB2C8\uB2E4."
    english: Choose a menu option to connect.
  - key: status_connecting
    korean: "\uC11C\uBC84\uC5D0 \uC5F0\uACB0\uD558\uB294 \uC911..."
    english: Connecting to server...
  - key: status_connected
    korean: "\uC11C\uBC84\uC5D0 \uC5F0\uACB0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    english: Connected to server.
  - key: status_matching
    korean: "{0}\uC778 \uB9E4\uCE6D \uC0C1\uB300\uB97C \uCC3E\uB294 \uC911..."
    english: Searching for a {0}-player match...
  - key: status_cancelling
    korean: "\uB9E4\uCE6D\uC744 \uCDE8\uC18C\uD558\uB294 \uC911..."
    english: Cancelling matchmaking...
  - key: status_room_created
    korean: "\uBC29\uC744 \uB9CC\uB4E4\uC5C8\uC2B5\uB2C8\uB2E4. \uBC29 \uCF54\uB4DC\uB97C
      \uCE5C\uAD6C\uC5D0\uAC8C \uC54C\uB824\uC8FC\uC138\uC694!"
    english: Room created. Share the room code!
  - key: status_joined_room
    korean: "\uBC29\uC5D0 \uCC38\uAC00\uD588\uC2B5\uB2C8\uB2E4."
    english: Joined the room.
  - key: status_in_lobby
    korean: "\uBC29 \uB85C\uBE44\uC5D0 \uC785\uC7A5\uD588\uC2B5\uB2C8\uB2E4."
    english: Entered the room lobby.
  - key: status_room_code_required
    korean: "\uBC29 \uCF54\uB4DC\uB97C \uC785\uB825\uD574\uC8FC\uC138\uC694."
    english: Enter a room code.
  - key: status_room_code_copied
    korean: "\uBC29 \uCF54\uB4DC\uB97C \uBCF5\uC0AC\uD588\uC2B5\uB2C8\uB2E4."
    english: Room code copied.
  - key: status_applying_settings
    korean: "\uBC29 \uC124\uC815\uC744 \uC801\uC6A9\uD558\uB294 \uC911..."
    english: Applying room settings...
  - key: status_readying
    korean: "\uC900\uBE44 \uC0C1\uD0DC\uB85C \uBCC0\uACBD\uD558\uB294 \uC911..."
    english: Setting ready...
  - key: status_unreadying
    korean: "\uC900\uBE44\uB97C \uCDE8\uC18C\uD558\uB294 \uC911..."
    english: Cancelling ready...
  - key: status_starting_game
    korean: "\uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uB294 \uC911..."
    english: Starting game...
  - key: status_leaving_room
    korean: "\uBC29\uC5D0\uC11C \uB098\uAC00\uB294 \uC911..."
    english: Leaving room...
  - key: status_error
    korean: "\uC624\uB958\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4."
    english: An error occurred.
  - key: selection_required
    korean: "\uCE90\uB9AD\uD130 \uC120\uD0DD\uC744 \uC644\uB8CC\uD574 \uC8FC\uC138\uC694."
    english: Complete your character selection.
  - key: your_team
    korean: "\uB0B4 \uD300 \uD3B8\uC131"
    english: YOUR SQUAD
  - key: select_player_team
    korean: "P{0} \uD300\uC744 \uC120\uD0DD\uD558\uC138\uC694"
    english: SELECT P{0}'S SQUAD
  - key: selection_hint
    korean: "\uC2AC\uB86F\uC744 \uACE0\uB974\uACE0 \uCE90\uB9AD\uD130\uB97C \uC120\uD0DD\uD558\uC138\uC694.
      {0}\uAC1C \xB7 \uC911\uBCF5 \uC120\uD0DD \uAC00\uB2A5"
    english: "Select a slot, then a character. {0} slots \xB7 duplicates allowed"
  - key: bulb_name
    korean: "\uC804\uAD6C"
    english: BULB
  - key: seed_name
    korean: "\uC528\uC557"
    english: SEED
  - key: bomb_name
    korean: "\uD3ED\uD0C4"
    english: BOMB
  - key: bulb_description
    korean: "\uC9C0\uC5ED \uD1B5\uC81C\uD615 \xB7 \uC720\uB9AC \uD30C\uD3B8, \uC804\uAE30
      \uC7A5\uD310, \uC5F0\uC1C4 \uC12C\uAD11\uC73C\uB85C \uC801\uC758 \uC6C0\uC9C1\uC784\uC744
      \uC81C\uD55C\uD569\uB2C8\uB2E4."
    english: "CONTROL \xB7 Glass shards, electric fields and chain flashes restrict
      enemy movement."
  - key: seed_description
    korean: "\uC9C0\uD615 \uC124\uACC4\uD615 \xB7 \uBC1C\uD310\uACFC \uB369\uAD74\uC744
      \uB9CC\uB4E4\uC5B4 \uC774\uB3D9\uB85C\uB97C \uC5F4\uACE0 \uAC00\uC2DC \uC7A5\uD310\uC73C\uB85C
      \uAE38\uBAA9\uC744 \uC9C0\uD0B5\uB2C8\uB2E4."
    english: "TERRAIN \xB7 Create platforms and vines, open new routes and defend
      with thorns."
  - key: bomb_description
    korean: "\uD30C\uAD34 \uACF5\uACA9\uD615 \xB7 \uAE30\uBCF8 \uD3ED\uD0C4, \uC9C0\uC5F0
      \uD3ED\uD0C4\uACFC \uC9D1\uC18D\uD0C4\uC73C\uB85C \uC5C4\uD3D0\uBB3C\uC744
      \uBB34\uB108\uB728\uB9BD\uB2C8\uB2E4."
    english: "DEMOLITION \xB7 Break cover with direct bombs, delayed blasts and cluster
      attacks."
  - key: local_play
    korean: "AI \uB300\uC804"
    english: AI BATTLE
  - key: local_title
    korean: "AI \uB300\uC804 \xB7 \uD300 \uD3B8\uC131"
    english: "AI BATTLE \xB7 SQUAD SELECT"
  - key: local_shared_screen
    korean: "\uC11C\uBC84 \uC5C6\uC774 \uCEF4\uD4E8\uD130 \uC0C1\uB300\uC640 \uC624\uD504\uB77C\uC778\uC73C\uB85C
      \uD50C\uB808\uC774\uD569\uB2C8\uB2E4."
    english: Play offline against computer-controlled opponents.
  - key: local_instructions
    korean: "\uAC01 \uD50C\uB808\uC774\uC5B4\uC758 \uD300\uC744 \uD655\uC815\uD55C
      \uB4A4 \uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uC138\uC694."
    english: Confirm each player's squad, then start the match.
  - key: confirm_team
    korean: "\uD300 \uD655\uC815"
    english: CONFIRM SQUAD
  - key: saving_team
    korean: "\uD300 \uC120\uD0DD\uC744 \uB3D9\uAE30\uD654\uD558\uB294 \uC911..."
    english: Synchronizing squad...
  - key: help
    korean: "\uD50C\uB808\uC774 \uBC29\uBC95"
    english: HOW TO PLAY
  - key: close
    korean: "\uB2EB\uAE30"
    english: CLOSE
  - key: quit
    korean: "\uAC8C\uC784 \uC885\uB8CC"
    english: QUIT GAME
  - key: help_body
    korean: "A / D : \uC774\uB3D9   W : \uC810\uD504\n\uB9C8\uC6B0\uC2A4 : \uC870\uC900  
      Space : \uCC28\uC9D5 / \uBC1C\uC0AC\nC : \uCC28\uC9D5 \uCDE8\uC18C   1 / 2
      / 3 : \uACE0\uC720 \uC2A4\uD0AC\n6 / 7 / 8 : \uACF5\uC6A9 \uBA38\uB9AC   Esc
      : \uC120\uD0DD \uCDE8\uC18C\nTab : \uD134 \uC885\uB8CC   \uD720 : \uCE74\uBA54\uB77C
      \uD655\uB300 / \uCD95\uC18C\n\n\uACF5\uACA9 \uD6C4\uC5D0\uB3C4 \uC794\uC874
      \uC2DC\uAC04 \uB3D9\uC548 \uC774\uB3D9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0
      \uC0B4\uC544\uB0A8\uC740 \uD50C\uB808\uC774\uC5B4\uC758 \uD300\uC774 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.\n\uACF5\uC6A9
      \uBA38\uB9AC\uB294 \uAC19\uC740 \uD300\uC774 \uACF5\uC720\uD558\uB294 \uC77C\uD68C\uC131
      \uC544\uC774\uD15C\uC785\uB2C8\uB2E4."
    english: 'A / D: move   W: jump

      Mouse: aim   Space: charge / fire

      C:
      cancel charge   1 / 2 / 3: skills

      6 / 7 / 8: common heads   Esc: cancel
      selection

      Tab: end turn   Wheel: zoom


      You can still move during
      residual time after attacking.

      The last surviving player''s squad wins.

      Common
      heads are single-use items shared by your squad.'
  - key: connection_help
    korean: "\uC11C\uBC84 \uC5F0\uACB0 \uC0C1\uD0DC\uB97C \uD655\uC778\uD55C \uD6C4
      \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
    english: Check the server connection and try again.
  - key: room_capacity_too_small
    korean: "\uD604\uC7AC \uCC38\uAC00 \uC778\uC6D0\uBCF4\uB2E4 \uC791\uAC8C \uC124\uC815\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    english: Capacity cannot be smaller than the current player count.
  - key: match_in_progress
    korean: "\uC774\uBBF8 \uC9C4\uD589 \uC911\uC778 \uACBD\uAE30\uC785\uB2C8\uB2E4."
    english: This match is already in progress.
  - key: host_only
    korean: "\uBC29\uC7A5\uB9CC \uC2E4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    english: Only the host can do this.
  - key: map_meadow
    korean: "\uC678\uB534 \uB4F1\uB300 \uC12C"
    english: Lonely Lighthouse
  - key: map_meadow_desc
    korean: "\uB192\uC740 \uB4F1\uB300\uC640 \uACC4\uB2E8 \uC808\uBCBD. \uC544\uB798
      \uB3D9\uAD74\uB85C \uC6B0\uD68C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    english: Tall lighthouse and stepped cliffs with a lower cave route.
  - key: map_citadel
    korean: "\uBB34\uB108\uC9C4 \uD56D\uAD6C"
    english: Ruined Harbor
  - key: map_citadel_desc
    korean: "\uD56D\uAD6C \uC808\uBCBD\uACFC \uC9C0\uBD95 \uC704\uC5D0\uC11C \uC2F8\uC6B0\uAC70\uB098
      \uAD00\uD1B5 \uB3D9\uAD74\uB85C \uC6B0\uD68C\uD558\uC138\uC694."
    english: Fight over harbor cliffs and roofs or take the through-cave route.
  - key: map_reef
    korean: "\uB09C\uD30C\uC120 \uD574\uC548"
    english: Shipwreck Coast
  - key: map_reef_desc
    korean: "\uAC08\uB77C\uC9C4 \uD574\uC548 \uC704 \uB09C\uD30C\uC120. \uC544\uB798
      \uD1B5\uB85C\uC640 \uAC11\uD310\uC758 \uACE0\uC800\uCC28\uB97C \uD65C\uC6A9\uD558\uC138\uC694."
    english: Shipwrecks above a split coast with decks and lower passages.
  - key: map_select
    korean: "\uC804\uC7A5 \uC120\uD0DD"
    english: BATTLEFIELD
  - key: choose_character
    korean: "\uCE90\uB9AD\uD130 \uC120\uD0DD"
    english: CHOOSE A CHARACTER
  - key: turn_player
    korean: "P{0}\uC758 \uD134 \xB7 {1} \uB77C\uC6B4\uB4DC"
    english: "P{0}'S TURN \xB7 ROUND {1}"
  - key: loading_battle
    korean: "\uC804\uC7A5\uC744 \uC900\uBE44\uD558\uB294 \uC911..."
    english: Preparing the battlefield...
  - key: timer_turn
    korean: "\uD134 \uB0A8\uC740 \uC2DC\uAC04  {0:0.0}\uCD08"
    english: TURN  {0:0.0}s
  - key: timer_residual
    korean: "\uC774\uB3D9 \uB0A8\uC740 \uC2DC\uAC04  {0:0.0}\uCD08"
    english: MOVEMENT  {0:0.0}s
  - key: timer_settlement
    korean: "\uD53C\uD574 \uC815\uC0B0  {0:0.0}\uCD08"
    english: RESOLVING  {0:0.0}s
  - key: cooldown_rounds
    korean: "\uB300\uAE30 {0}"
    english: WAIT {0}
  - key: empty_slot
    korean: "\uBE44\uC5B4 \uC788\uC74C"
    english: EMPTY
  - key: end_turn
    korean: "\uD134 \uC885\uB8CC"
    english: END TURN
  - key: battle_menu
    korean: "\uBA54\uB274"
    english: MENU
  - key: resume
    korean: "\uACC4\uC18D\uD558\uAE30"
    english: RESUME
  - key: return_title
    korean: "\uD0C0\uC774\uD2C0\uB85C \uB098\uAC00\uAE30"
    english: LEAVE TO TITLE
  - key: match_winner
    korean: "P{0} \uD300 \uC2B9\uB9AC!"
    english: P{0} WINS!
  - key: match_draw
    korean: "\uBB34\uC2B9\uBD80"
    english: DRAW
  - key: result_online
    korean: "\uBC29\uC7A5\uC774 \uB85C\uBE44\uB85C \uB3CC\uC544\uAC00\uAE30\uB97C
      \uC120\uD0DD\uD558\uBA74 \uAC19\uC740 \uBC29\uC5D0\uC11C \uB2E4\uC2DC \uD3B8\uC131\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    english: The host can return everyone to the lobby for another match.
  - key: result_local
    korean: "\uAC19\uC740 \uD300\uC73C\uB85C \uC7AC\uACBD\uAE30\uD558\uAC70\uB098
      \uD0C0\uC774\uD2C0\uC5D0\uC11C \uB2E4\uC2DC \uD3B8\uC131\uD558\uC138\uC694."
    english: Play again with these squads or choose new squads from the title.
  - key: replay
    korean: "\uC7AC\uACBD\uAE30 / \uB85C\uBE44\uB85C"
    english: PLAY AGAIN / LOBBY
  - key: connection_lost
    korean: "\uC11C\uBC84 \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC84C\uC2B5\uB2C8\uB2E4"
    english: CONNECTION LOST
  - key: player_disconnected
    korean: "\uCC38\uAC00\uC790\uC758 \uC5F0\uACB0\uC774 \uB04A\uC5B4\uC84C\uC2B5\uB2C8\uB2E4"
    english: A PLAYER DISCONNECTED
  - key: disconnect_return
    korean: "\uD0C0\uC774\uD2C0\uB85C \uB3CC\uC544\uAC00\uC11C \uB2E4\uC2DC \uC811\uC18D\uD574
      \uC8FC\uC138\uC694."
    english: Return to the title to reconnect.
  - key: team_health
    korean: "\uD300 \uCCB4\uB825"
    english: SQUAD HEALTH
  - key: battle_skills
    korean: "\uACE0\uC720 \uBA38\uB9AC"
    english: SKILLS
  - key: battle_common
    korean: "\uACF5\uC6A9 \uBA38\uB9AC"
