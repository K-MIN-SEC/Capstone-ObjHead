    korean: "AI \uD3B8\uC131 \xB7 \uB79C\uB364"
    english: "AI ROSTER \xB7 RANDOM"
  - key: ai_roster_fixed
    korean: "AI \uD3B8\uC131 \xB7 \uACE0\uC815"
    english: "AI ROSTER \xB7 FIXED"
  - key: ai_difficulty_beginner
    korean: "AI \uB09C\uC774\uB3C4 \xB7 \uCD08\uBCF4"
